# Nothing is required to run locally: pick a mode in the app.
# Optional, local only: use this Claude key without pasting it in the app.
# ANTHROPIC_API_KEY=
# Optional: any OpenAI-compatible local server (default: Ollama on :11434, then LM Studio on :1234).
# STUDIO_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# Hosted deployments: set this (openssl rand -base64 32) so encrypted cookies survive deploys.
# STUDIO_COOKIE_SECRET=
